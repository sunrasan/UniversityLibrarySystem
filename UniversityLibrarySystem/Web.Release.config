<?xml version="1.0" encoding="utf-8"?>
<!--
  CLOUD READINESS: Web.config transformation files are superseded by environment variables
  and AWS Systems Manager Parameter Store for cloud deployments.
  
  Instead of using Web.Debug.config / Web.Release.config build-time transformations:
  1. Store environment-specific configuration in AWS Systems Manager Parameter Store.
  2. Load configuration at runtime using AWSSDK.SimpleSystemsManagement.
  3. Set environment variables from Parameter Store values in your ECS task definition
     or Kubernetes ConfigMap/Secret.
  
  This enables true immutable deployments where the same artifact runs in all environments.
  Configuration is injected at runtime rather than baked into build artifacts.
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <!--
    Environment-specific settings are now managed via:
    - AWS Systems Manager Parameter Store for non-sensitive config
    - AWS Secrets Manager for sensitive values (connection strings, API keys)
    
    Set the following environment variables from AWS SSM Parameter Store:
    - DB_CONNECTION_STRING: Database connection string
    - DB_EF_CONNECTION_STRING: Entity Framework connection string
    - SMS_API_KEY: SMS service API key
    - SMS_API_URL: SMS service URL
    - SMS_VERIFY_API_URL: SMS verification URL
  -->
  <system.web>
    <!--
      Release compilation settings are controlled via environment variables
      rather than build-time transformation.
      Debug mode is disabled in production via ASPNET_COMPILATION_DEBUG=false.
    -->
  </system.web>
</configuration>

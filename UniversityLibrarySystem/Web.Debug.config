<?xml version="1.0" encoding="utf-8"?>
<!--
  cr-dotnet-0010: Web.config transformation files (Web.Debug.config, Web.Release.config) are
  replaced by environment variables and AWS Systems Manager Parameter Store.
  
  Configuration is injected at runtime rather than baked into build artifacts, enabling
  true immutable deployments and seamless promotion across dev/staging/production.
  
  Required environment variables (set in ECS task definition or EKS pod spec):
    ASPNETCORE_ENVIRONMENT   - Environment name (Development/Staging/Production)
    ULS_CONNECTION_STRING    - SQL Server connection string (from AWS Secrets Manager)
    REDIS_SESSION_ENDPOINT   - ElastiCache Redis endpoint
    SMS_API_KEY              - SMS API key (from AWS Secrets Manager)
    SMS_API_URL              - SMS API URL (from SSM Parameter Store)
    MACHINE_KEY_VALIDATION   - Machine key validation key (from AWS Secrets Manager)
    MACHINE_KEY_DECRYPTION   - Machine key decryption key (from AWS Secrets Manager)
  
  This file is intentionally left without active transformations.
  All environment-specific configuration is managed via AWS Systems Manager Parameter Store
  and AWS Secrets Manager, not build-time XML transformations.
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <!--
    Debug-specific: disable compilation debug mode via environment variable instead.
    In cloud deployments, set ASPNETCORE_ENVIRONMENT=Development to enable debug features.
  -->
  <system.web>
    <!-- No build-time transformations needed – use environment variables instead -->
  </system.web>
</configuration>
